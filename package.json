{
  "name": "react-use-echarts",
  "version": "3.3.2",
  "private": false,
  "description": "React hooks & component for Apache ECharts — TypeScript, auto-resize, themes, lazy init",
  "keywords": [
    "apache-echarts",
    "chart-linkage",
    "charts",
    "data-visualization",
    "echarts",
    "echarts-for-react",
    "echarts-react",
    "esm",
    "hooks",
    "lazy-loading",
    "react",
    "react-component",
    "react-hooks",
    "resize-observer",
    "themes",
    "typescript",
    "vite-plus"
  ],
  "homepage": "https://chensid.github.io/react-use-echarts/",
  "bugs": {
    "url": "https://github.com/chensid/react-use-echarts/issues"
  },
  "license": "MIT",
  "author": "Ethan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chensid/react-use-echarts.git"
  },
  "files": [
    "AGENTS.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/development/index.js",
      "default": "./dist/index.js"
    },
    "./themes/registry": {
      "types": "./dist/themes/registry.d.ts",
      "default": "./dist/themes/registry.js"
    },
    "./preset-full": {
      "types": "./dist/preset-full.d.ts",
      "default": "./dist/preset-full.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "size": "size-limit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "vp pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.9",
    "@changesets/cli": "^3.0.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "echarts": "^6.1.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shiki": "^4.5.0",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "size-limit": [
    {
      "name": "dist/index.js (gzip, unminified, JSDoc stripped — production build, dev-only warnings removed)",
      "path": "dist/index.js",
      "limit": "7 KB",
      "gzip": true,
      "brotli": false
    },
    {
      "name": "dist/development/index.js (gzip, unminified, JSDoc stripped — development build with dev-only warnings)",
      "path": "dist/development/index.js",
      "limit": "8 KB",
      "gzip": true,
      "brotli": false
    },
    {
      "name": "dist/themes/registry.js (gzip)",
      "path": "dist/themes/registry.js",
      "limit": "2 KB",
      "gzip": true,
      "brotli": false
    },
    {
      "name": "dist/preset-full.js (gzip)",
      "path": "dist/preset-full.js",
      "limit": "0.5 KB",
      "gzip": true,
      "brotli": false
    }
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.19.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
